# Copy this file to `.env` and adjust as needed, or set these as
# Environment= lines in dropzone.service — either works.
# Every variable is optional; Dropzone runs fine with none of these set.

# ── Core ──────────────────────────────────────────────────────────
# Port the app listens on.
DROPZONE_PORT=8000

# Where uploaded files and the SQLite database are stored.
DROPZONE_DATA=./data

# ── Access ────────────────────────────────────────────────────────
# If set, the whole drop zone is locked behind this PIN.
# Leave blank/unset to keep it open to anyone on your network.
DROPZONE_PIN=

# ── Limits & lifecycle ───────────────────────────────────────────
# Maximum size of a single uploaded file, in megabytes.
DROPZONE_MAX_MB=2048

# Auto-delete items older than this many days. 0 = never expire.
DROPZONE_EXPIRE_DAYS=0

# ── Remote screen viewer (optional) ─────────────────────────────
# Local port x11vnc listens on — only reachable via the bridge below.
DROPZONE_VNC_PORT=5900

# Port the browser connects to for the live screen viewer.
DROPZONE_WS_PORT=6080
