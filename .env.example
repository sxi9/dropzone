# Copy this file to `.env` and adjust as needed, or set these as
# Environment= lines in dropzone.service — either works.
# Every variable is optional; Dropzone runs fine with none of these set.

# ── Core ──────────────────────────────────────────────────────────
# Port the app listens on.
DROPZONE_PORT=8000

# Where uploaded files and the SQLite database are stored.
DROPZONE_DATA=./data

# ── Access ────────────────────────────────────────────────────────
# Preferred: create accounts once with
#     python app.py set-password admin
#     python app.py set-password user
# They are stored hashed in data/users.json. The variables below are an
# alternative that (re)sets the password every time the service starts.
DROPZONE_ADMIN_PASSWORD=
DROPZONE_USER_PASSWORD=

# Legacy shared PIN. Still accepted as the "user" password while no user
# account exists. Leave everything blank to keep the drop zone open.
DROPZONE_PIN=

# How many hours a login stays valid.
DROPZONE_SESSION_HOURS=24

# Set to 1 when Dropzone is reached over HTTPS (e.g. `tailscale serve`),
# so session cookies are marked Secure.
DROPZONE_HTTPS=0

# Set to 1 only when a reverse proxy (tailscale serve, nginx, Caddy) sits in
# front of Dropzone and sets X-Forwarded-For / X-Forwarded-Proto.
DROPZONE_TRUST_PROXY=0

# Set to 1 to let per-item share links (/s/<token>) work without a login.
DROPZONE_PUBLIC_SHARE=0

# ── Limits & lifecycle ───────────────────────────────────────────
# Maximum size of a single uploaded file, in megabytes.
DROPZONE_MAX_MB=2048

# Auto-delete items older than this many days. 0 = never expire.
DROPZONE_EXPIRE_DAYS=0

# ── Remote screen viewer (optional) ─────────────────────────────
# Local port x11vnc listens on — only reachable via the bridge below.
DROPZONE_VNC_PORT=5900

# Port the browser connects to for the live screen viewer.
DROPZONE_WS_PORT=6080
